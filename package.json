{
  "name": "314rate",
  "version": "1.0.0",
  "description": "Game aggregator with clean minimal UI",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npx serve client -l 3000 --no-clipboard",
    "start": "node server/index.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
